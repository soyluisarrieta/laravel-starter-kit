includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - phpstan-baseline.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7
    # Our models declare casts() as a plain array, so Larastan has to read
    # its body to learn the real type of each attribute.
    parseModelCastsMethod: true

